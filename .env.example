# Variáveis de ambiente da Pauta (nunca versionar o arquivo .env)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Banco SQLite (opcional; padrão: output/pauta.db)
PAUTA_DB_PATH=output/pauta.db

# Cookie de sessão: 0 no localhost (HTTP), 1 com HTTPS em produção
PAUTA_COOKIE_SECURE=0

# Não usar no MVP (reservado apenas ao motor local pyannote/Whisper):
# HF_TOKEN=
